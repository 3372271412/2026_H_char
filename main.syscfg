GPIO4.associatedPins[3].pin.$assign = "PB24";

GPIO5.$name                         = "GPIO_KEY_USER";
GPIO5.associatedPins[0].$name            = "PIN_KEY_USER";
GPIO5.associatedPins[0].direction        = "INPUT";
GPIO5.associatedPins[0].internalResistor = "PULL_UP";
